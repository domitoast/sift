# =============================================================================
# 環境變數範本
#
# 這個檔案「要」進版控，作用是告訴新加入的人「需要設定哪些變數」。
# 裡面全部是假值，不含任何真實機密。
#
# 使用方式：
#   1. 複製一份改名為 .env
#   2. 把值換成自己的
#   3. .env 已列入 .gitignore，不會被提交
#
# 這是業界標準做法——新人 clone 專案後看這個檔案就知道要準備什麼，
# 而不是啟動失敗後才一個一個猜。
# =============================================================================

# --- 資料庫 ---
SIFT_DB_NAME=sift
SIFT_DB_USER=sift
SIFT_DB_PASSWORD=change_me

# --- JWT 簽章金鑰 ---
# 必須是 Base64 編碼、至少 512 bits（64 bytes）的隨機值。
#
# PowerShell 產生方式：
#   $bytes = New-Object byte[] 64
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
#
# Linux / macOS：
#   openssl rand -base64 64
SIFT_JWT_SECRET=REPLACE_WITH_A_RANDOM_BASE64_KEY_AT_LEAST_64_BYTES

# --- Token 有效期 ---
SIFT_JWT_ACCESS_TTL_MINUTES=15
SIFT_JWT_REFRESH_TTL_DAYS=7

# =============================================================================
# 摘要
# =============================================================================
#
# 是否讓「假的摘要器」可用。
#
# ⚠️ 正式環境一律不要開。開了之後使用者就可以把供應商設成 FAKE，
#    拿到的摘要是 substring，不是 AI 寫的。
#
# 「用哪一家」不在這裡設定——那是每個使用者自己選的（BYOK），
# 存在 app_user.llm_provider。
SIFT_SUMMARIZE_ALLOW_FAKE=true

# 模型與逾時通常不用改，這裡列出來是為了讓人知道它們可以改。
#SIFT_GEMINI_MODEL=gemini-3.8-flash
#SIFT_GEMINI_TIMEOUT=30s

# ⚠️ Gemini 的 API key「不在這裡」。
#
# 它是「每個使用者自己的」（BYOK），加密後存在 app_user.llm_api_key_encrypted，
# 由使用者在畫面上設定。放進環境變數等於全站共用一把、由我們付錢。
