# Template for .env. Committed on purpose: it is what tells a new developer
# which variables they need, instead of leaving them to guess after a failed
# start-up. Every value here is a placeholder.
#
#   1. cp .env.example .env
#   2. fill in the two keys below
#   3. .env is gitignored

# --- Database -------------------------------------------------------------
SIFT_DB_NAME=sift
SIFT_DB_USER=sift
SIFT_DB_PASSWORD=change_me

# --- JWT signing key ------------------------------------------------------
# Base64, at least 512 bits (64 bytes).
#
#   openssl rand -base64 64
#
# PowerShell:
#   $b = New-Object byte[] 64
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
SIFT_JWT_SECRET=REPLACE_WITH_A_RANDOM_BASE64_KEY_AT_LEAST_64_BYTES

SIFT_JWT_ACCESS_TTL_MINUTES=15
SIFT_JWT_REFRESH_TTL_DAYS=7

# --- Encryption key for stored LLM API keys -------------------------------
# Base64, decoding to exactly 256 bits (32 bytes).
#
#   openssl rand -base64 32
#
# Deliberately separate from the JWT key. Leaking the signing key means tokens
# can be forged; leaking this one means every user's API key is readable. The
# blast radiuses differ, and rotating one must not break the other.
SIFT_ENCRYPTION_SECRET=REPLACE_WITH_A_RANDOM_BASE64_KEY_OF_EXACTLY_32_BYTES

# --- Summarization --------------------------------------------------------
# Whether the fake summarizer is registered at all.
#
# Never true in a deployed environment: it would let a user pick FAKE and get
# a substring instead of a summary. Which provider to use is per-user (stored
# in app_user.llm_provider), not a deployment setting.
SIFT_SUMMARIZE_ALLOW_FAKE=true

#SIFT_GEMINI_MODEL=gemini-3.8-flash
#SIFT_GEMINI_TIMEOUT=30s

# Gemini API keys are not set here. Each user supplies their own through the
# UI; it is encrypted into app_user.llm_api_key_encrypted. A key in this file
# would mean one shared key, paid for by whoever runs the server.
