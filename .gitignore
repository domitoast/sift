# Maven 建置產出
target/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# 作業系統產生的檔案
.DS_Store
Thumbs.db
desktop.ini

# 日誌
*.log
logs/

# 環境變數與機密資料（絕對不可進版控）
#
# ⚠️ 注意 .env.example 是「例外」——它只有假值，
#    作用是告訴新人需要準備哪些變數，必須進版控。
.env
.env.local
!.env.example
*.pem
*.key

# 本機專用的設定覆寫（若日後使用 profile）
application-local.yml
application-local.yaml

# 若日後改用 Gradle
.gradle/
build/

# 手動測試 API 時用的暫存 payload（curl -d "@xxx.json"）
#
# 這些檔案裡會有真實的 token 與密碼，絕對不可進版控。
# 需要長期保留的請求範例，請放到 docs/ 並改用假值。
/*.json
